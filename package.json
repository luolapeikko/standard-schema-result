{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "@luolapeikko/standard-schema-result",
	"version": "0.0.2",
	"description": "Rust style result type for standard schema validation",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": "./dist/index.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format cjs,esm --dts --clean",
		"prepublishOnly": "npm run build",
		"test": "vitest test --run --no-isolate --coverage",
		"lint": "biome check",
		"validate": "tsc --noEmit --project tsconfig.test.json"
	},
	"repository": "github:luolapeikko/standard-schema-result",
	"keywords": [
		"zod",
		"valibot",
		"arktype",
		"result",
		"rust",
		"validation",
		"standard-schema"
	],
	"author": "mharj",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@luolapeikko/result-option": "^2.4.0",
		"@standard-schema/spec": "^1.1.0",
		"@standard-schema/utils": "^0.3.0",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^25.9.9",
		"@vitest/coverage-v8": "^5.0.3",
		"c8": "^12.0.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@luolapeikko/result-option": ">= 2.0.0",
		"@standard-schema/spec": ">= 1.1.0",
		"@standard-schema/utils": ">= 0.3.0"
	},
	"packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
